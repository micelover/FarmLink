rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Anyone can read products; only the owning farmer can write
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.farmerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.farmerId;
    }

    // Orders: buyers can read their own, farmers can read orders containing their products
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.farmerIds.hasAny([request.auth.uid])
      );
      // Only Cloud Functions (admin SDK) can write orders
      allow write: if false;
    }

    // Payouts: only the farmer who requested can read
    match /payouts/{payoutId} {
      allow read: if request.auth != null && resource.data.farmerId == request.auth.uid;
      allow write: if false;
    }
  }
}
